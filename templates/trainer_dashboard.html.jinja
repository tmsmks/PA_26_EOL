<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Espace formateur — End of Life</title>
<link rel="stylesheet" href="{{ url_for('static', filename='shared/theme.css') }}">
<link rel="stylesheet" href="{{ url_for('static', filename='play.css') }}">
<link rel="stylesheet" href="{{ url_for('static', filename='account.css') }}">
</head>
<body class="play-menu">
{% from "_export_form.html.jinja" import export_form %}
{% include "_userbar.html.jinja" %}
<main class="acc-wrap">
    <nav class="acc-crumbs"><a href="{{ url_for('pages.landing') }}">← Tous les livres</a><a href="{{ url_for('expert_key.index') }}">Clé de cotation (validation par des experts) →</a></nav>
    <header class="acc-header">
        <p class="eyebrow">Espace formateur</p>
        <h1>Participant·e·s</h1>
        <p class="acc-sub">{{ rows | length }} compte{{ 's' if rows | length > 1 }} · note du livre = moyenne des niveaux des chapitres évalués, nombre de chapitres évalués entre parenthèses.</p>
    </header>

    {%- if debriefs or fast %}
    <section class="acc-card acc-critical" aria-labelledby="h-debrief">
        <h2 id="h-debrief">À débriefer</h2>
        {%- if debriefs %}
        <p class="acc-hint">Réponses critiques dans le dernier passage noté d'un chapitre. Elles ne se compensent pas : un échange avec la personne est recommandé (le débriefing humain est ce qui rend les patients virtuels efficaces).</p>
        <ul class="critical-list">
            {%- for d in debriefs %}
            <li><a href="{{ url_for('account.trainer_participant', user_id=d.user.id) }}">{{ d.user.display_name | e }}</a> · {{ d.book | e }} · chapitre {{ d.chapter | e }} · {{ d.answers | length }} réponse{{ 's' if d.answers | length > 1 }} critique{{ 's' if d.answers | length > 1 }}
                <ul>{% for it in d.answers %}<li><span class="muted">{{ it.scene_title | e }}</span> — {{ it.text | e }}</li>{% endfor %}</ul>
            </li>
            {%- endfor %}
        </ul>
        {%- endif %}
        {%- if fast %}
        <h3>Passages trop rapides</h3>
        <p class="acc-hint">Plus d'un quart des choix faits en moins de 2 secondes : le passage ne compte pas dans le niveau (seuil provisoire, à calibrer sur le pilote).</p>
        <ul class="critical-list">
            {%- for f in fast %}
            <li><a href="{{ url_for('account.trainer_participant', user_id=f.user.id) }}">{{ f.user.display_name | e }}</a> · {{ f.book | e }} · chapitre {{ f.chapter_id }} · {{ f.n_fast }}/{{ f.n_timed }} choix rapides · {{ f.at | date_fr }}</li>
            {%- endfor %}
        </ul>
        {%- endif %}
    </section>
    {%- endif %}

    <section class="acc-card">
        <div class="acc-toolbar">
            <h2>Suivi</h2>
            <input class="acc-search" id="search" type="search" placeholder="Nom ou identifiant…" aria-label="Rechercher un participant">
        </div>
        <div class="acc-table-wrap">
        <table class="acc-table" id="participants">
            <thead><tr>
                <th>Participant</th>
                <th class="num">Passages notés</th>
                <th class="num">Sessions en cours</th>
                {%- for b in books %}<th class="num">{{ b.title }}</th>{% endfor %}
                <th>Dernière activité</th>
            </tr></thead>
            <tbody>
            {%- for r in rows %}
            <tr data-search="{{ (r.user.display_name ~ ' ' ~ r.user.username) | lower }}">
                <td>
                    <a href="{{ url_for('account.trainer_participant', user_id=r.user.id) }}">{{ r.user.display_name }}</a>
                    <span class="muted">@{{ r.user.username }}{% if r.user.is_trainer %} · formateur·rice{% endif %}</span>
                </td>
                <td class="num">{{ r.n_passages or '—' }}</td>
                <td class="num">{{ r.n_in_progress or '—' }}</td>
                {%- for b in books %}
                {%- set pf = r.profiles[b.slug] %}
                <td class="num">{% if pf.global is not none %}{{ pf.global | note(1) }} <span class="muted">({{ pf.n_evaluated }}/{{ pf.n_chapters }})</span>{% else %}<span class="muted">—</span>{% endif %}</td>
                {%- endfor %}
                <td class="muted nowrap">{{ r.last_activity | date_fr(true) }}</td>
            </tr>
            {%- else %}
            <tr><td colspan="{{ 4 + books | length }}" class="muted">Aucun compte pour l'instant.</td></tr>
            {%- endfor %}
            </tbody>
        </table>
        </div>
    </section>

    <section class="acc-card" aria-labelledby="h-chapters">
        <div class="acc-toolbar">
            <h2 id="h-chapters">Niveaux par chapitre</h2>
            <form class="acc-inline-form" method="get" action="{{ url_for('account.trainer_dashboard') }}">
                <label>Livre
                    <select name="book" onchange="this.form.submit()">
                        {%- for b in books %}
                        <option value="{{ b.slug }}"{% if b.slug == detail_book.slug %} selected{% endif %}>{{ b.title }}</option>
                        {%- endfor %}
                    </select>
                </label>
                <noscript><button class="ghost-btn small" type="submit">Afficher</button></noscript>
            </form>
        </div>
        <p class="acc-hint">Niveau de chaque chapitre (moyenne des passages notés, pondérée par leur ancienneté) et, entre parenthèses, le nombre de passages notés. ▲ / ▼ : progrès ou baisse nets depuis le premier passage. ! : réponse critique à débriefer.</p>
        <div class="acc-table-wrap">
        <table class="acc-table" id="chapter-levels">
            <thead><tr>
                <th>Participant</th>
                {%- for ch in detail_chapters %}<th class="num" title="{{ ch.Name }}">Ch. {{ ch.Id }}</th>{% endfor %}
            </tr></thead>
            <tbody>
            {%- for r in rows if r.detail | selectattr('level') | list %}
            <tr>
                <td><a href="{{ url_for('account.trainer_participant', user_id=r.user.id) }}">{{ r.user.display_name }}</a></td>
                {%- for c in r.detail %}
                {%- set lv = c.level %}
                <td class="num">
                    {%- if lv %}{{ lv.level | note }} <span class="muted">({{ lv.n_passages }})</span>
                    {%- if lv.progress and lv.progress.status == 'net_gain' %} <span class="delta-up" title="Progrès net : {{ '%+d' % (lv.gain | round | int) }} points">▲</span>
                    {%- elif lv.progress and lv.progress.status == 'net_loss' %} <span class="delta-down" title="Baisse nette : {{ '%+d' % (lv.gain | round | int) }} points">▼</span>{% endif %}
                    {%- if lv.critical_capped %} <span class="delta-down" title="Réponse critique à débriefer">!</span>{% endif %}
                    {%- else %}<span class="muted">—</span>{% endif -%}
                </td>
                {%- endfor %}
            </tr>
            {%- else %}
            <tr><td colspan="{{ 1 + detail_chapters | length }}" class="muted">Aucun chapitre noté dans ce livre pour l'instant.</td></tr>
            {%- endfor %}
            </tbody>
        </table>
        </div>
    </section>

    <section class="acc-card" aria-labelledby="h-group">
        <h2 id="h-group">Progrès du groupe · {{ detail_book.title | e }}</h2>
        <p class="acc-hint">Personnes qui ont au moins deux passages notés d'un chapitre : moyenne du premier et du dernier passage, et <em>d</em> de Cohen (écart des moyennes divisé par l'écart-type moyen), avec la corrélation entre les deux passages. Repères usuels : 0,2 petit, 0,5 moyen, 0,8 grand. C'est la mesure recommandée pour un groupe, plutôt que le gain normalisé (Nissen et al. 2018).</p>
        {%- if group | selectattr('change') | list %}
        <div class="acc-table-wrap">
        <table class="acc-table">
            <thead><tr><th>Chapitre</th><th class="num">Personnes</th><th class="num">1ᵉʳ passage</th><th class="num">Dernier passage</th><th class="num"><em>d</em> de Cohen</th><th class="num">Corrélation</th></tr></thead>
            <tbody>
            {%- for g in group if g.change %}
            <tr>
                <td>{{ g.id }}. {{ g.name | e }}</td>
                <td class="num">{{ g.change.n }}</td>
                <td class="num">{{ g.change.mean_first | note(1) }} <span class="muted">(σ {{ g.change.sd_first | note(1) }})</span></td>
                <td class="num">{{ g.change.mean_last | note(1) }} <span class="muted">(σ {{ g.change.sd_last | note(1) }})</span></td>
                <td class="num"><strong>{% if g.change.d is not none %}{{ '%+.2f' | format(g.change.d) | replace('.', ',') }}{% else %}—{% endif %}</strong></td>
                <td class="num">{% if g.change.r is not none %}{{ '%.2f' | format(g.change.r) | replace('.', ',') }}{% else %}—{% endif %}</td>
            </tr>
            {%- endfor %}
            </tbody>
        </table>
        </div>
        {%- else %}
        <p class="acc-empty">Apparaît dès que deux personnes ont rejoué un même chapitre en passage noté.</p>
        {%- endif %}
    </section>

    <section class="acc-card" aria-labelledby="h-export">
        <h2 id="h-export">Données brutes</h2>
        <p class="acc-hint">Tout ce qui a été joué, une ligne par objet : comptes, sessions, chapitres, scènes et choix, avec un dictionnaire des colonnes. Le fichier Excel s'ouvre tel quel ; le CSV et le JSON servent aux autres outils (R, Python, SPSS…). Pseudonymiser remplace identifiants et noms par un code stable (P001…).</p>
        {{ export_form(books=books) }}
    </section>
</main>
<script>
document.getElementById("search").addEventListener("input", function (e) {
    var q = e.target.value.trim().toLowerCase();
    document.querySelectorAll("#participants tbody tr[data-search]").forEach(function (tr) {
        tr.hidden = q !== "" && tr.dataset.search.indexOf(q) === -1;
    });
});
</script>
</body>
</html>
